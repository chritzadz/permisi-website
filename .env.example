# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Database (Neon Postgres) -------------------------------------------------
# First one found wins; either works.
NETLIFY_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# DATABASE_URL=

# --- Admin login ---------------------------------------------------------------
# Used by the `/admin/login` panel.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# --- API key (shared-secret write guard) ---------------------------------------
# These two MUST match. The server checks incoming `x-api-key` against
# API_SECRET_KEY; the client sends NEXT_PUBLIC_API_KEY as that header.
# ⚠️ NEXT_PUBLIC_* is exposed to the browser — this is a deterrent, not a secret.
API_SECRET_KEY=change-me
NEXT_PUBLIC_API_KEY=change-me

# --- Google service account (Sheet submissions) --------------------------------
# From the service-account JSON key. The private key keeps its \n escapes and is
# wrapped in double quotes. Share every target Google Sheet with
# GOOGLE_CLIENT_EMAIL as an Editor.
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=permisi-website@PROJECT_ID.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_X509_CERT_URL=
